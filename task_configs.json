{
  "任务类型": [
    {
      "名称": "下载YouTube视频",
      "标识": "yt_download",
      "描述": "从YouTube下载视频，支持断点续传、转码、信息文件",
      "要素列表": [
        {"字段": "video_url",     "显示名": "视频链接",    "类型": "text",     "必填": true,  "提示": "YouTube视频URL，如 https://youtu.be/xxx"},
        {"字段": "title", "显示名": "标题", "类型": "text", "必填": false, "默认": "", "提示": "留空则使用视频原标题"},
        {"字段": "description",   "显示名": "描述",        "类型": "textarea", "必填": false, "默认": "", "提示": "视频描述信息"},
        {"字段": "tags",          "显示名": "内容标签",     "类型": "text",     "必填": false, "默认": "", "提示": "逗号分隔，如：教程,Python,AI"},
        {"字段": "execute_time",  "显示名": "执行时间",     "类型": "datetime", "必填": false, "默认": "立即", "提示": "格式 YYYY-MM-DD HH:mm，留空立即执行"}
      ],
      "配置映射": {
        "阶段列表": [
          {
            "阶段名": "下载",
            "命令行": ["python", "yt_download.py", "{fields.video_url}"],
            "失败策略": "中止",
            "超时秒": 1800
          }
        ]
      }
    },
    {
      "名称": "下载YouTube并发布到微信视频号",
      "标识": "yt_download_and_publish",
      "描述": "下载YouTube视频 → 适配准备 → 通过桌面自动化发布到微信视频号",
      "要素列表": [
        {"字段": "video_url",     "显示名": "视频链接",     "类型": "text",     "必填": true,  "提示": "YouTube视频URL，如 https://youtu.be/xxx"},
        {"字段": "title", "显示名": "标题", "类型": "text", "必填": false, "默认": "", "提示": "留空则使用视频原标题"},
        {"字段": "description",   "显示名": "描述",         "类型": "textarea", "必填": false, "默认": "", "提示": "视频描述（可选）"},
        {"字段": "tags",          "显示名": "内容标签",      "类型": "text",     "必填": false, "默认": "", "提示": "逗号分隔，将转为 #标签 附加到描述末尾"},
        {"字段": "publish_time",  "显示名": "发布时间",     "类型": "text",     "必填": false, "默认": "立即", "提示": "视频号定时发布（留空立即发布）"},
        {"字段": "execute_time",  "显示名": "执行时间",     "类型": "datetime", "必填": false, "默认": "立即", "提示": "格式 YYYY-MM-DD HH:mm，留空立即执行"}
      ],
      "类型配置": {
        "发布模板路径": "wf_publish.template.json",
        "发布目录": "WeChatAppEx",
        "标题截断长度": 30,
        "描述截断长度": 200
      },
      "配置映射": {
        "阶段列表": [
          {
            "阶段名": "下载视频",
            "命令行": ["python", "yt_download.py", "{fields.video_url}"],
            "失败策略": "中止",
            "超时秒": 1800,
            "后处理适配器": "yt_download_to_publish"
          },
          {
            "阶段名": "发布到视频号",
            "命令行": ["python", "run_workflow.py", "--stdin"],
            "失败策略": "通知继续",
            "超时秒": 600,
            "输入准备适配器": "publish_prepare"
          }
        ]
      }
    }
  ]
}
